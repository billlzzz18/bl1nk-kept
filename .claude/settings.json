{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo clippy --quiet 2>&1 | head -20"
          }
        ]
      }
    ],
    "PreCommit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo test --quiet 2>&1 | tail -5"
          }
        ]
      }
    ]
  }
}
